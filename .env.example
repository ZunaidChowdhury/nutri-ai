# Frontend — required for Vercel deployment
#
# Set every variable below in the Vercel dashboard (Project → Settings → Environment
# Variables). NEXT_PUBLIC_* values are inlined at build time. NEXT_PUBLIC_SHOW_DEV_BAR
# must be 0 (or unset) in production.

# Backend Render URL WITHOUT /api — the api suffix is added in src/lib/core/server.ts.
# Example: https://nutri-ai-server.onrender.com
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# This app's own deployed Vercel URL. Example: https://nutri-ai.vercel.app
NEXT_PUBLIC_APP_URL=https://your-frontend.vercel.app

# BetterAuth secret — must match the backend's BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=your-better-auth-secret-change-in-production

# BetterAuth base URL used for OAuth callbacks — same as NEXT_PUBLIC_APP_URL
BETTER_AUTH_URL=https://your-frontend.vercel.app

# MongoDB Atlas connection string (shared with the backend)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nutri-ai?appName=Cluster0

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Uploadthing token for meal images
UPLOADTHING_TOKEN=your-uploadthing-token

# 1 = show developer bar in layout, 0 = hide
NEXT_PUBLIC_SHOW_DEV_BAR=0

# Google sign-in users with this email get role: admin
ADMIN_EMAIL=programmer.zunaid@gmail.com